[Unit]
Description=Workspace Workbench
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 -m workspace_workbench serve --config %h/.config/workspace-workbench/project.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
