    "@types/node": "^22.10.0",
    "@types/prismjs": "^1.26.3",
    "@types/react": "~19.2.0",
    "react": "^19.1.0",
    "react-native": "^0.81.5",
    "typescript": "^5.7.2",
    "zod": "^4.4.3"
