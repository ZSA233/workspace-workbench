{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["node", "react"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["./index.*", "./client/**/*", "./server/**/*", "./shared/**/*", "./tests/**/*"]
}
