+  it("hands a routed host to the system without reading the full file or claiming completion", async () => {
+    access.web = true;
+    access.handoff.mockResolvedValue(true);
+    const token = createTokenRequest();
+    const reader = createFileReader(async () => ({
+      bytes: FILE_BYTES,
+      size: FILE_BYTES.byteLength,
+    }));
+    const saver = createFileSaver();
+    const download = await startDownload({
+      profile: profileWith([relayConnection]),
+      activeConnectionId: relayConnection.id,
+      token,
+      reader,
+      saver,
+    });
+    expect(download).toMatchObject({ status: "delegated" });
+    expect(token.requested).toEqual([FILE_PATH]);
+    expect(reader.requested).toEqual([]);
+    expect(saver.savedFiles).toEqual([]);
+    expect(access.handoff).toHaveBeenCalledWith({
+      serverId: "srv_remote",
+      token: "tok",
+      filename: FILE_NAME,
+    });
+  });
+  it("does not replay a rejected handoff through the legacy socket or save an empty file", async () => {
+    access.web = true;
+    access.handoff.mockRejectedValue(new Error("Access expired"));
+    const reader = createFileReader(async () => ({
+      bytes: FILE_BYTES,
+      size: FILE_BYTES.byteLength,
+    }));
